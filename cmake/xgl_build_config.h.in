#ifndef XGL_BUILD_CONFIG_H
#define XGL_BUILD_CONFIG_H
#define XGL_BUILD_PROFILE "@XGL_PROFILE@"
#if defined(XGL_BUILD_CONFIG_ID) && XGL_BUILD_CONFIG_ID != @XGL_BUILD_CONFIG_ID@U
#error "XGL_BUILD_CONFIG_ID conflicts with the compiled protocol"
#endif
#ifndef XGL_BUILD_CONFIG_ID
#define XGL_BUILD_CONFIG_ID @XGL_BUILD_CONFIG_ID@U
#endif
#if defined(XGL_RESOURCE_CONFIG_ID) && \
    XGL_RESOURCE_CONFIG_ID != @XGL_RESOURCE_CONFIG_ID@U
#error "XGL_RESOURCE_CONFIG_ID conflicts with the compiled protocol"
#endif
#ifndef XGL_RESOURCE_CONFIG_ID
#define XGL_RESOURCE_CONFIG_ID @XGL_RESOURCE_CONFIG_ID@U
#endif
#if defined(XGL_EXPECTED_RESOURCE_CONFIG_ID) && \
    XGL_EXPECTED_RESOURCE_CONFIG_ID != XGL_RESOURCE_CONFIG_ID
#error "xgl headers and target have different compiled resource identities"
#endif
#define XGL_BUILD_RX_CHUNK_SIZE @XGL_BUILD_RX_CHUNK_SIZE@U
#define XGL_CONFIG_ABI_VERSION 3U
#define XGL_FEATURE_ROUTE_INDEX @XGL_FEATURE_ROUTE_INDEX@
#define XGL_SECURITY_SESSION_CAPACITY @XGL_SECURITY_SESSION_CAPACITY@
#define XGL_FEATURE_AUTH @XGL_FEATURE_AUTH@
#define XGL_FEATURE_FORWARDING @XGL_FEATURE_FORWARDING@
#define XGL_FEATURE_FRAGMENTATION @XGL_FEATURE_FRAGMENTATION@
#define XGL_FEATURE_OUT_OF_ORDER @XGL_FEATURE_OUT_OF_ORDER@
#define XGL_FEATURE_DIAGNOSTICS @XGL_FEATURE_DIAGNOSTICS@
#define XGL_FEATURE_STATISTICS @XGL_FEATURE_STATISTICS@
#if defined(XGL_RELIABLE_BUCKET_COUNT) && \
    XGL_RELIABLE_BUCKET_COUNT != @XGL_RELIABLE_BUCKET_COUNT@U
#error "XGL_RELIABLE_BUCKET_COUNT conflicts with the compiled protocol"
#endif
#ifndef XGL_RELIABLE_BUCKET_COUNT
#define XGL_RELIABLE_BUCKET_COUNT @XGL_RELIABLE_BUCKET_COUNT@U
#endif
#if defined(XGL_BUILD_WINDOW_CAPACITY) && \
    XGL_BUILD_WINDOW_CAPACITY != @XGL_BUILD_WINDOW_CAPACITY@U
#error "XGL_BUILD_WINDOW_CAPACITY conflicts with the compiled protocol"
#endif
#ifndef XGL_BUILD_WINDOW_CAPACITY
#define XGL_BUILD_WINDOW_CAPACITY @XGL_BUILD_WINDOW_CAPACITY@U
#endif
#if defined(XGL_FEATURE_ADAPTIVE_RTO) && \
    XGL_FEATURE_ADAPTIVE_RTO != @XGL_FEATURE_ADAPTIVE_RTO@
#error "XGL_FEATURE_ADAPTIVE_RTO conflicts with the compiled protocol"
#endif
#ifndef XGL_FEATURE_ADAPTIVE_RTO
#define XGL_FEATURE_ADAPTIVE_RTO @XGL_FEATURE_ADAPTIVE_RTO@
#endif
#endif
