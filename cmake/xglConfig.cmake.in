@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT TARGET xgs::status)
    find_dependency(xgen_status 0.1 CONFIG COMPONENTS status)
endif()
if(NOT TARGET xgb::bytes)
    find_dependency(xgen_bytes 0.1 CONFIG COMPONENTS bytes)
endif()
if(NOT TARGET xgcrc::crc16)
    find_dependency(xgen_crc 0.1 CONFIG COMPONENTS crc16)
endif()
set(_xgl_memory_components allocator pool size_class)
if(@XGL_ALLOW_FALLBACK_MALLOC@)
    list(APPEND _xgl_memory_components libc_allocator)
endif()
set(_xgl_memory_missing FALSE)
foreach(_xgl_component IN LISTS _xgl_memory_components)
    if(NOT TARGET xgm::${_xgl_component})
        set(_xgl_memory_missing TRUE)
    endif()
endforeach()
if(_xgl_memory_missing)
    find_dependency(xgen_memory 0.1 CONFIG COMPONENTS ${_xgl_memory_components})
endif()
set(_xgl_container_components list bitset)
if(@XGL_FEATURE_ROUTE_INDEX@)
    list(APPEND _xgl_container_components hash)
endif()
set(_xgl_containers_missing FALSE)
foreach(_xgl_component IN LISTS _xgl_container_components)
    if(NOT TARGET xgct::${_xgl_component})
        set(_xgl_containers_missing TRUE)
    endif()
endforeach()
if(_xgl_containers_missing)
    find_dependency(xgen_containers 0.1 CONFIG COMPONENTS ${_xgl_container_components})
endif()
include("${CMAKE_CURRENT_LIST_DIR}/XglDependencyVersions.cmake")
xgl_check_dependency(xgs::status XGS)
xgl_check_dependency(xgb::bytes XGB)
xgl_check_dependency(xgcrc::crc16 XGCRC)
foreach(_xgl_component IN LISTS _xgl_memory_components)
    xgl_check_dependency(xgm::${_xgl_component} XGM)
endforeach()
foreach(_xgl_component IN LISTS _xgl_container_components)
    xgl_check_dependency(xgct::${_xgl_component} XGCT)
endforeach()
unset(_xgl_memory_components)
unset(_xgl_container_components)
unset(_xgl_memory_missing)
unset(_xgl_containers_missing)
unset(_xgl_component)
include("${CMAKE_CURRENT_LIST_DIR}/xglTargets.cmake")

check_required_components(xgl)
