@PACKAGE_INIT@

set(xgl_PROFILE "@XGL_PROFILE@")
set(xgl_CONFIG_ABI_VERSION @XGL_CONFIG_ABI_VERSION@)
set(xgl_BUILD_CONFIG_ID @XGL_BUILD_CONFIG_ID@)
set(xgl_RESOURCE_CONFIG_ID "@XGL_RESOURCE_CONFIG_ID@")
set(xgl_RELIABLE_INDEX_BUCKETS @XGL_RELIABLE_BUCKET_COUNT@)
set(xgl_TRANSPORT_WINDOW_CAPACITY @XGL_BUILD_WINDOW_CAPACITY@)
set(xgl_ENABLE_ADAPTIVE_RTO @XGL_FEATURE_ADAPTIVE_RTO@)
set(xgl_ENABLE_ADVANCED_RUNTIME @XGL_FEATURE_ADVANCED_RUNTIME@)
set(xgl_CAPABILITIES "@XGL_CAPABILITIES@")
set(xgl_FOUND TRUE)
unset(xgl_NOT_FOUND_MESSAGE)
set(_xgl_missing_capabilities)
foreach(_xgl_capability IN LISTS xgl_CAPABILITIES)
    set(xgl_${_xgl_capability}_FOUND TRUE)
endforeach()
foreach(_xgl_capability IN LISTS xgl_FIND_COMPONENTS)
    if(NOT _xgl_capability IN_LIST xgl_CAPABILITIES)
        set(xgl_${_xgl_capability}_FOUND FALSE)
        if(xgl_FIND_REQUIRED_${_xgl_capability})
            list(APPEND _xgl_missing_capabilities "${_xgl_capability}")
        endif()
    endif()
endforeach()
unset(_xgl_capability)

check_required_components(xgl)
if(NOT xgl_FOUND)
    list(JOIN _xgl_missing_capabilities ", " _xgl_missing_capabilities)
    set(xgl_NOT_FOUND_MESSAGE "Unsupported xgl capability: ${_xgl_missing_capabilities}")
    unset(_xgl_missing_capabilities)
    return()
endif()
unset(_xgl_missing_capabilities)

include("${CMAKE_CURRENT_LIST_DIR}/xglTargets.cmake")
get_target_property(_xgl_target_identity xgl::xgl XGL_RESOURCE_CONFIG_ID)
get_target_property(_xgl_target_build_id xgl::xgl XGL_BUILD_CONFIG_ID)
get_target_property(_xgl_target_abi xgl::xgl XGL_CONFIG_ABI_VERSION)
if(NOT _xgl_target_abi STREQUAL xgl_CONFIG_ABI_VERSION)
    message(FATAL_ERROR "xgl::xgl conflicts with the requested SDK configuration ABI")
endif()
if(NOT _xgl_target_identity STREQUAL xgl_RESOURCE_CONFIG_ID OR
   NOT _xgl_target_build_id STREQUAL xgl_BUILD_CONFIG_ID)
    message(FATAL_ERROR "xgl::xgl conflicts with the requested SDK resource identity")
endif()
unset(_xgl_target_abi)
unset(_xgl_target_identity)
unset(_xgl_target_build_id)
