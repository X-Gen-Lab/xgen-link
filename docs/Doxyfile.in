# Share the public-header validation policy with the quality runner.
@INCLUDE               = "@PROJECT_SOURCE_DIR@/Doxyfile"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
OUTPUT_DIRECTORY       = "@XGL_DOXYGEN_OUTPUT_DIR@"
WARN_LOGFILE           = "@XGL_DOXYGEN_OUTPUT_DIR@/warnings.log"
INPUT                  = "@PROJECT_SOURCE_DIR@/include/xgl/xgl.h" \
                         "@PROJECT_SOURCE_DIR@/include/xgl/xgl_config.h" \
                         "@PROJECT_SOURCE_DIR@/include/xgl/xgl_types.h" \
                         "@PROJECT_SOURCE_DIR@/include/xgl/xgl_error.h"
GENERATE_HTML          = YES
GENERATE_XML           = NO
FULL_PATH_NAMES        = NO
DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = YES
HTML_OUTPUT            = html
