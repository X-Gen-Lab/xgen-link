# Share the public-header validation policy with the quality runner.
@INCLUDE               = "@XGL_SOURCE_DIRECTORY@/Doxyfile"
PROJECT_NUMBER         = "@XGL_DOC_VERSION@"
OUTPUT_DIRECTORY       = "@XGL_DOXYGEN_OUTPUT_DIR@"
WARN_LOGFILE           = "@XGL_DOXYGEN_OUTPUT_DIR@/warnings.log"
GENERATE_HTML          = YES
GENERATE_XML           = NO
FULL_PATH_NAMES        = NO
DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = YES
HTML_OUTPUT            = html
