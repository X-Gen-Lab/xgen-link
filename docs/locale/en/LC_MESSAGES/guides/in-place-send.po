msgstr "Base header"

#: docs/zh/guides/in-place-send.md:0
msgid "`XGL_FRAME_HEADER_SIZE`（24）"
msgstr "`XGL_FRAME_HEADER_SIZE` (24)"

#: docs/zh/guides/in-place-send.md:0
