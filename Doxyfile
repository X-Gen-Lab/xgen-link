# X-Gen quality 0.1.0. The runner selects the public protocol headers.
PROJECT_NAME           = xgen-link
OUTPUT_DIRECTORY       = out/reports/doxygen
INPUT                  = include/xgl/xgl.h include/xgl/xgl_config.h include/xgl/xgl_types.h include/xgl/xgl_error.h
FILE_PATTERNS          = *.h
RECURSIVE              = NO
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = out/reports/doxygen/warnings.log
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
QUIET                  = YES
