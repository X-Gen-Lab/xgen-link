{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "gcc-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "host-validation",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "XGL_BUILD_TESTS": "ON",
        "XGL_BUILD_EXAMPLES": "ON",
        "XGL_BUILD_NOHEAP_SMOKE": "ON",
        "XGL_BUILD_SDK_CONSUMER_SMOKE": "ON",
        "XGL_BUILD_FOOTPRINT_REPORT": "ON",
        "XGL_BUILD_RELEASE_VALIDATION_TARGET": "ON"
      }
    },
    {
      "name": "gcc-validation",
      "hidden": true,
      "inherits": [
        "gcc-base",
        "host-validation"
      ]
    },
    {
      "name": "gcc-coverage",
      "hidden": true,
      "inherits": "gcc-validation",
      "cacheVariables": {
        "XGL_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "bounded",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "XGL_BUILD_TESTS": "OFF",
        "XGL_BUILD_EXAMPLES": "OFF",
        "XGL_ALLOW_FALLBACK_MALLOC": "OFF"
      }
    },
    {
      "name": "bounded-host-validation",
      "hidden": true,
      "cacheVariables": {
        "XGL_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Native host regression and examples",
      "inherits": "host-validation"
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized release build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "XGL_BUILD_TESTS": "OFF",
        "XGL_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "test",
      "displayName": "Test",
      "description": "Build and test with GCC and coverage enabled",
      "inherits": "gcc-coverage"
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "description": "Debug build using GCC on Windows or MinGW-like environments",
      "inherits": "gcc-validation"
    },
    {
      "name": "gcc-test",
      "displayName": "GCC Test",
      "description": "Test build using GCC without MSVC runtime requirements",
      "inherits": "gcc-validation",
      "cacheVariables": {
        "XGL_ENABLE_COVERAGE": "OFF"
      }
    },
    {
      "name": "ci",
      "displayName": "CI",
      "description": "Full host validation with advanced runtime and coverage",
      "inherits": "gcc-coverage",
      "cacheVariables": {
        "XGL_PROFILE": "full",
        "XGL_ENABLE_ADVANCED_RUNTIME": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "ASan",
      "description": "AddressSanitizer + UndefinedBehaviorSanitizer build",
      "inherits": "gcc-validation",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "native-debug",
      "displayName": "Native Debug",
      "inherits": "debug"
    },
    {
      "name": "native-release",
      "displayName": "Native Release",
      "inherits": "host-validation",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "native-asan",
      "displayName": "Native ASan and UBSan",
      "inherits": "asan"
    },
    {
      "name": "native-tsan",
      "displayName": "Native TSan",
      "inherits": "gcc-validation",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "boot",
      "inherits": "bounded",
      "cacheVariables": {
        "XGL_PROFILE": "boot"
      }
    },
    {
      "name": "boot-small",
      "displayName": "Boot Small",
      "description": "Boot with one window slot and fixed RTO",
      "inherits": "boot",
      "cacheVariables": {
        "XGL_RELIABLE_INDEX_BUCKETS": "1",
        "XGL_TRANSPORT_WINDOW_CAPACITY": "1",
        "XGL_ENABLE_ADAPTIVE_RTO": "OFF"
      }
    },
    {
      "name": "embedded-lite",
      "inherits": "bounded",
      "cacheVariables": {
        "XGL_PROFILE": "embedded-lite"
      }
    },
    {
      "name": "embedded",
      "inherits": "bounded",
      "cacheVariables": {
        "XGL_PROFILE": "embedded"
      }
    },
    {
      "name": "boot-host-test",
      "displayName": "boot host regression",
      "description": "Native GoogleTest regression; requires a matching host compiler and GoogleTest installation",
      "inherits": [
        "bounded-host-validation",
        "boot"
      ]
    },
    {
      "name": "boot-small-host-test",
      "displayName": "Boot Small host regression",
      "description": "Native GoogleTest regression with one window slot and fixed RTO",
      "inherits": [
        "bounded-host-validation",
        "boot-small"
      ]
    },
    {
      "name": "embedded-lite-host-test",
      "displayName": "embedded-lite host regression",
      "description": "Native GoogleTest regression; requires a matching host compiler and GoogleTest installation",
      "inherits": [
        "bounded-host-validation",
        "embedded-lite"
      ]
    },
    {
      "name": "embedded-host-test",
      "displayName": "embedded host regression",
      "description": "Native GoogleTest regression; requires a matching host compiler and GoogleTest installation",
      "inherits": [
        "bounded-host-validation",
        "embedded"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "displayName": "Debug Build",
      "description": "Build debug configuration"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "displayName": "Release Build",
      "description": "Build release configuration"
    },
    {
      "name": "test",
      "configurePreset": "test",
      "displayName": "Test Build",
      "description": "Build test configuration"
    },
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "displayName": "GCC Debug Build",
      "description": "Build GCC debug configuration"
    },
    {
      "name": "gcc-test",
      "configurePreset": "gcc-test",
      "displayName": "GCC Test Build",
      "description": "Build GCC test configuration"
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "displayName": "CI Build",
      "description": "Build CI configuration"
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "displayName": "ASan Build",
      "description": "Build with AddressSanitizer"
    },
    {
      "name": "native-debug",
      "configurePreset": "native-debug"
    },
    {
      "name": "native-release",
      "configurePreset": "native-release"
    },
    {
      "name": "native-asan",
      "configurePreset": "native-asan"
    },
    {
      "name": "native-tsan",
      "configurePreset": "native-tsan",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "boot",
      "configurePreset": "boot"
    },
    {
      "name": "boot-small",
      "configurePreset": "boot-small"
    },
    {
      "name": "embedded-lite",
      "configurePreset": "embedded-lite"
    },
    {
      "name": "embedded",
      "configurePreset": "embedded"
    },
    {
      "name": "boot-host-test",
      "configurePreset": "boot-host-test"
    },
    {
      "name": "boot-small-host-test",
      "configurePreset": "boot-small-host-test"
    },
    {
      "name": "embedded-lite-host-test",
      "configurePreset": "embedded-lite-host-test"
    },
    {
      "name": "embedded-host-test",
      "configurePreset": "embedded-host-test"
    }
  ],
  "testPresets": [
    {
      "name": "test-results",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "bounded-tests",
      "hidden": true,
      "inherits": "test-results",
      "filter": {
        "include": {
          "label": "^xgl$"
        }
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "inherits": "test-results"
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "inherits": "test-results"
    },
    {
      "name": "test",
      "configurePreset": "test",
      "displayName": "Run Tests",
      "description": "Run all tests",
      "inherits": "test-results"
    },
    {
      "name": "gcc-test",
      "configurePreset": "gcc-test",
      "displayName": "Run GCC Tests",
      "description": "Run all tests from the GCC test build",
      "inherits": "test-results"
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "displayName": "Run ASan Tests",
      "description": "Run tests with AddressSanitizer",
      "inherits": "test-results"
    },
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "inherits": "test-results"
    },
    {
      "name": "native-release",
      "configurePreset": "native-release",
      "inherits": "test-results"
    },
    {
      "name": "native-asan",
      "configurePreset": "native-asan",
      "inherits": "test-results"
    },
    {
      "name": "native-tsan",
      "configurePreset": "native-tsan",
      "inherits": "test-results",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "boot-host-test",
      "configurePreset": "boot-host-test",
      "inherits": "bounded-tests"
    },
    {
      "name": "boot-small-host-test",
      "configurePreset": "boot-small-host-test",
      "inherits": "bounded-tests"
    },
    {
      "name": "embedded-lite-host-test",
      "configurePreset": "embedded-lite-host-test",
      "inherits": "bounded-tests"
    },
    {
      "name": "embedded-host-test",
      "configurePreset": "embedded-host-test",
      "inherits": "bounded-tests"
    }
  ]
}
