{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "gcc-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with all features enabled",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "XGL_BUILD_TESTS": "ON",
        "XGL_BUILD_EXAMPLES": "ON",
        "XGL_BUILD_DOCS": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized release build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "XGL_BUILD_TESTS": "OFF",
        "XGL_BUILD_EXAMPLES": "ON",
        "XGL_BUILD_DOCS": "OFF"
      }
    },
    {
      "name": "test",
      "displayName": "Test",
      "description": "Build with tests and coverage enabled",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "XGL_BUILD_TESTS": "ON",
        "XGL_BUILD_EXAMPLES": "ON",
        "XGL_BUILD_DOCS": "OFF",
        "XGL_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "description": "Debug build using GCC on Windows or MinGW-like environments",
      "inherits": "gcc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "XGL_BUILD_TESTS": "ON",
        "XGL_BUILD_EXAMPLES": "ON",
        "XGL_BUILD_DOCS": "OFF"
      }
    },
    {
      "name": "gcc-test",
      "displayName": "GCC Test",
      "description": "Test build using GCC without MSVC runtime requirements",
      "inherits": "gcc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "XGL_BUILD_TESTS": "ON",
        "XGL_BUILD_EXAMPLES": "ON",
        "XGL_BUILD_DOCS": "OFF",
        "XGL_ENABLE_COVERAGE": "OFF"
      }
    },
    {
      "name": "ci",
      "displayName": "CI",
      "description": "Continuous integration build",
      "inherits": "gcc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "XGL_BUILD_TESTS": "ON",
        "XGL_BUILD_EXAMPLES": "ON",
        "XGL_BUILD_DOCS": "ON",
        "XGL_ENABLE_COVERAGE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "displayName": "Debug Build",
      "description": "Build debug configuration"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "displayName": "Release Build",
      "description": "Build release configuration"
    },
    {
      "name": "test",
      "configurePreset": "test",
      "displayName": "Test Build",
      "description": "Build test configuration"
    },
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "displayName": "GCC Debug Build",
      "description": "Build GCC debug configuration"
    },
    {
      "name": "gcc-test",
      "configurePreset": "gcc-test",
      "displayName": "GCC Test Build",
      "description": "Build GCC test configuration"
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "displayName": "CI Build",
      "description": "Build CI configuration"
    }
  ],
  "testPresets": [
    {
      "name": "test",
      "configurePreset": "test",
      "displayName": "Run Tests",
      "description": "Run all tests",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc-test",
      "configurePreset": "gcc-test",
      "displayName": "Run GCC Tests",
      "description": "Run all tests from the GCC test build",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
