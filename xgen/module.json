{
  "schema": 1,
  "id": "xgen-link",
  "kind": "component",
  "build": {
    "backend": "cmake",
    "entry": "."
  },
  "public": {
    "package": "xgl",
    "targets": [
      "xgl::xgl"
    ],
    "abi": "3"
  },
  "capabilities": {
    "features": [
      "wire",
      "reliable",
      "authentication",
      "forwarding",
      "fragmentation",
      "out_of_order",
      "statistics",
      "diagnostics",
      "advanced_runtime"
    ],
    "limits": {},
    "choices": {
      "profile": [
        "boot",
        "embedded-lite",
        "embedded",
        "full"
      ]
    }
  },
  "requires": [
    {
      "module": "xgen-status",
      "abi": "1",
      "features": [
        "status"
      ],
      "forbidden": [],
      "limits": {},
      "choices": {}
    },
    {
      "module": "xgen-bytes",
      "abi": "1",
      "features": [
        "bytes"
      ],
      "forbidden": [],
      "limits": {},
      "choices": {}
    },
    {
      "module": "xgen-crc",
      "abi": "1",
      "features": [
        "crc16"
      ],
      "forbidden": [],
      "limits": {},
      "choices": {}
    },
    {
      "module": "xgen-memory",
      "abi": "1",
      "features": [
        "allocator",
        "pool",
        "size_class"
      ],
      "forbidden": [],
      "limits": {},
      "choices": {}
    },
    {
      "module": "xgen-containers",
      "abi": "1",
      "features": [
        "list",
        "bitset"
      ],
      "forbidden": [],
      "limits": {},
      "choices": {}
    }
  ]
}
